#!/bin/sh
# Dead man's switch. Pings an external URL every few minutes with a short
# vitals summary; the external service alerts when the pings stop.
#
# This exists because every other monitor on this boat writes to InfluxDB on
# the Pi. When the Pi dies, the evidence and the alarm die with it, and the
# failure is invisible until someone drives to the marina. A watchdog reset
# leaves no log tail at all (reference/legacy_openplotter_stack.md), so
# silence is the only signal that survives the box it is reporting on.
#
# It also alarms rather than only reporting. Silence covers the box being
# gone; the thresholds below cover it being in trouble while still alive,
# which nothing else off-boat catches. Crossing one pings <url>/fail instead
# of <url>, which most check services treat as an immediate failure rather
# than waiting out the grace period.
#
# Inert until configured: it reads the ping URL from /etc/boat-heartbeat.json,
# which host/install.sh places from host/boat-heartbeat.json in the repo. That
# file's `url` field is sops-encrypted, so the URL lives in version control
# without sitting in a public repo in the clear. Removing the installed file
# turns the heartbeat off again. See RUNBOOK -> "Turning on the off-boat
# heartbeat".
#
# The URL is a bearer credential: anyone holding it can send false "alive"
# pings, which masks a dead boat rather than leaking anything. Hence 0600.
set -eu

URL_FILE=/etc/boat-heartbeat.json

[ -r "$URL_FILE" ] || exit 0
# Deliberately not a JSON parser. This file is generated and single-purpose,
# and a heartbeat that needs python to find its own URL is one more thing that
# can fail on a box sick enough to be worth alerting about.
URL=$(sed -n 's/.*"url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$URL_FILE" | head -n 1)
[ -n "$URL" ] || exit 0
# An unrendered sops file means the smudge filter never ran where this was
# installed from. Pinging the literal string "ENC[...]" would look like a
# working heartbeat, so refuse instead.
case "$URL" in ENC\[*) logger -t boat-heartbeat "url is still sops ciphertext, not pinging"; exit 0 ;; esac

# Pushover, for the two escalation paths below. Optional like everything
# else here: an unconfigured box just skips both and behaves as before.
PUSHOVER_TOKEN=$(sed -n 's/.*"pushover_api_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$URL_FILE" | head -n 1)
PUSHOVER_USER=$(sed -n 's/.*"pushover_user_key"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$URL_FILE" | head -n 1)
case "$PUSHOVER_TOKEN" in ENC\[*) PUSHOVER_TOKEN="" ;; esac
case "$PUSHOVER_USER" in ENC\[*) PUSHOVER_USER="" ;; esac

# Every field is optional. A box sick enough to be worth alerting on is also
# a box where any one of these commands can hang or vanish, and a heartbeat
# that dies collecting its own payload reports the wrong thing.
v_uptime=$(uptime -p 2>/dev/null || echo "unknown")
v_load=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo "unknown")
v_mem=$(awk '/MemAvailable/ {printf "%d MB", $2/1024}' /proc/meminfo 2>/dev/null || echo "unknown")
v_disk=$(df -h / 2>/dev/null | awk 'NR==2 {print $5" of "$2}' || echo "unknown")
v_temp=$(vcgencmd measure_temp 2>/dev/null | cut -d= -f2 || echo "unknown")
v_throttled=$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2 || echo "unknown")
v_clock=$(chronyc tracking 2>/dev/null | awk -F': *' '/^System time/ {print $2}' || echo "unknown")
v_failed=$(systemctl list-units --state=failed --no-legend --plain 2>/dev/null | awk '{print $1}' | paste -sd, - || echo "unknown")
[ -n "$v_failed" ] || v_failed="none"

# Checkout drift, diagnostics only -- being behind origin is the normal state
# of a boat that deploys deliberately, so it never alarms. Local refs only, so
# no network work here; boat-hourly-sync.timer does the fetching. The fetch age
# is what separates a failing fetch from a merely undeployed change.
repo_state() {
	_dir=$1; _ref=$2; _fh=$3
	[ -d "$_dir" ] || { printf 'absent'; return; }
	# safe.directory: this runs as root against pi's checkout.
	_n=$(git -c safe.directory='*' --git-dir="$_dir" rev-list --count "HEAD..$_ref" 2>/dev/null)
	case "$_n" in ''|*[!0-9]*) printf 'unknown'; return ;; esac
	_age=""
	if [ -f "$_fh" ]; then
		_m=$(stat -c %Y "$_fh" 2>/dev/null)
		case "$_m" in ''|*[!0-9]*) ;; *) _age=$(( ( $(date +%s) - _m ) / 60 )) ;; esac
	fi
	if [ "$_n" = 0 ]; then printf 'current'; else printf '%s behind' "$_n"; fi
	[ -n "$_age" ] && printf ', fetched %sm ago' "$_age"
}
v_symphony=$(repo_state /home/pi/symphony/.git origin/main /home/pi/symphony/.git/FETCH_HEAD)
v_dotfiles=$(repo_state /home/pi/.local/share/yadm/repo.git origin/main /home/pi/.local/share/yadm/repo.git/FETCH_HEAD)
# A rolled-back autostash leaves only a stash entry as evidence; yadm reports
# exit 0. Anything but 0 wants a human.
v_stash=$(git -c safe.directory='*' --git-dir=/home/pi/.local/share/yadm/repo.git \
	--work-tree=/home/pi stash list 2>/dev/null | wc -l)
case "$v_stash" in ''|*[!0-9]*) v_stash="unknown" ;; esac
[ "$v_stash" = 0 ] || v_dotfiles="$v_dotfiles, ${v_stash} stashed"

# Thresholds. Silence tells you the box is gone; these tell you it is in
# trouble while still alive, which is the gap nothing else off-boat covers.
# 400 MB matches what this project already calls real memory pressure, and is
# the same condition signalk-healthcheck alarms on aboard -- the two are
# deliberately the same number so the boat and the phone agree.
MEM_ALARM_MB=400
DISK_ALARM_PCT=90

# Numeric forms, separate from the display strings above. Both may come back
# empty on a box too sick to read /proc -- in that case say nothing rather
# than alarm, since a genuinely dead box is caught by the ping going missing.
n_mem=$(awk '/MemAvailable/ {printf "%d", $2/1024; exit}' /proc/meminfo 2>/dev/null || true)
n_disk=$(df -P / 2>/dev/null | awk 'NR==2 {gsub(/%/,"",$5); print $5}' || true)

reasons=""
case "$n_mem" in ''|*[!0-9]*) ;; *)
	[ "$n_mem" -lt "$MEM_ALARM_MB" ] && reasons="memory available ${n_mem} MB < ${MEM_ALARM_MB}" ;;
esac
case "$n_disk" in ''|*[!0-9]*) ;; *)
	[ "$n_disk" -ge "$DISK_ALARM_PCT" ] &&
		reasons="${reasons:+$reasons; }disk ${n_disk}% >= ${DISK_ALARM_PCT}%" ;;
esac
case "$v_failed" in ''|none|unknown) ;; *)
	reasons="${reasons:+$reasons; }failed units: ${v_failed}" ;;
esac

# Require two consecutive samples before calling it down, so a value sitting
# on the threshold doesn't alternate up/down every five minutes and train you
# to ignore the alert. The counter lives on tmpfs on purpose: a reboot should
# start the count over rather than alarm on the first sample after it.
TRIPS=/run/boat-heartbeat.trips
if [ -n "$reasons" ]; then
	n=$(cat "$TRIPS" 2>/dev/null || echo 0)
	case "$n" in ''|*[!0-9]*) n=0 ;; esac
	n=$((n + 1))
	echo "$n" > "$TRIPS" 2>/dev/null || true
	[ "$n" -ge 2 ] || reasons=""
else
	rm -f "$TRIPS" 2>/dev/null || true
fi

# Soft warning tier: a quiet Pushover buzz for the band below the alarm
# thresholds above, so trouble shows up on the phone before it's bad enough
# to page. Never touches /fail -- that's the alarm path's job. Only checked
# when not already alarming, and only sent once per crossing (WARN_FLAG),
# so a sustained warning doesn't repeat every 5-minute cycle.
MEM_WARN_MB=600
DISK_WARN_PCT=80
WARN_FLAG=/run/boat-heartbeat.warned
if [ -z "$reasons" ] && [ -n "$PUSHOVER_TOKEN" ] && [ -n "$PUSHOVER_USER" ]; then
	warn_reasons=""
	case "$n_mem" in ''|*[!0-9]*) ;; *)
		[ "$n_mem" -lt "$MEM_WARN_MB" ] && warn_reasons="memory available ${n_mem} MB < ${MEM_WARN_MB}" ;;
	esac
	case "$n_disk" in ''|*[!0-9]*) ;; *)
		[ "$n_disk" -ge "$DISK_WARN_PCT" ] &&
			warn_reasons="${warn_reasons:+$warn_reasons; }disk ${n_disk}% >= ${DISK_WARN_PCT}%" ;;
	esac
	if [ -n "$warn_reasons" ]; then
		if [ ! -f "$WARN_FLAG" ]; then
			curl -fsS --max-time 15 \
				--form-string "token=$PUSHOVER_TOKEN" \
				--form-string "user=$PUSHOVER_USER" \
				--form-string "title=Symphony: early warning" \
				--form-string "message=$warn_reasons" \
				--form-string "priority=-1" \
				https://api.pushover.net/1/messages.json >/dev/null 2>&1 \
				&& touch "$WARN_FLAG"
		fi
	else
		rm -f "$WARN_FLAG" 2>/dev/null || true
	fi
fi

if [ -n "$reasons" ]; then
	v_status="ALARM: $reasons"
	PING_URL="${URL%/}/fail"
else
	v_status="ok"
	PING_URL="$URL"
fi

BODY=$(printf 'status: %s\nuptime: %s\nload: %s\nmem available: %s\ndisk: %s\ntemp: %s\nthrottled: %s\nclock: %s\nfailed units: %s\nsymphony: %s\ndotfiles: %s\n' \
	"$v_status" "$v_uptime" "$v_load" "$v_mem" "$v_disk" "$v_temp" "$v_throttled" "$v_clock" "$v_failed" \
	"$v_symphony" "$v_dotfiles")

# A boat loses its uplink routinely. A missed ping is the expected case, not a
# fault, so this exits 0 either way rather than leaving a failed unit behind
# for someone to chase.
#
# Fails-silent escalation: healthchecks.io can't report its own outage, so a
# run of failed pings needs a second channel. Only escalates if a probe to an
# unrelated host (Cloudflare's resolver, by IP so DNS can't be the reason it
# fails) succeeds -- otherwise this is just the boat's uplink being down,
# which is the expected case above, not an escalation. PING_FAILS persists
# the count across runs on tmpfs, same as TRIPS; ESCALATED gates it to one
# Pushover message per outage rather than one every 5 minutes.
PING_FAILS=/run/boat-heartbeat.pingfails
ESCALATED=/run/boat-heartbeat.escalated
PUSHOVER_FAILS_THRESHOLD=3

if printf '%s' "$BODY" | curl -fsS --max-time 20 --retry 2 --retry-delay 5 \
	--data-binary @- "$PING_URL" >/dev/null 2>&1; then
	rm -f "$PING_FAILS" "$ESCALATED" 2>/dev/null || true
	if [ -n "$reasons" ]; then
		logger -t boat-heartbeat "ping sent to /fail -- $reasons"
	else
		logger -t boat-heartbeat "ping ok"
	fi
else
	logger -t boat-heartbeat "ping failed (offline or endpoint down)"
	pf=$(cat "$PING_FAILS" 2>/dev/null || echo 0)
	case "$pf" in ''|*[!0-9]*) pf=0 ;; esac
	pf=$((pf + 1))
	echo "$pf" > "$PING_FAILS" 2>/dev/null || true
	if [ "$pf" -ge "$PUSHOVER_FAILS_THRESHOLD" ] && [ ! -f "$ESCALATED" ] \
		&& [ -n "$PUSHOVER_TOKEN" ] && [ -n "$PUSHOVER_USER" ] \
		&& curl -fsS --max-time 8 -o /dev/null https://1.1.1.1; then
		curl -fsS --max-time 15 \
			--form-string "token=$PUSHOVER_TOKEN" \
			--form-string "user=$PUSHOVER_USER" \
			--form-string "title=Symphony monitoring is down" \
			--form-string "message=$pf consecutive pings to healthchecks.io have failed while the boat's uplink is up. healthchecks.io can't report its own outage -- check it by hand." \
			--form-string "priority=1" \
			https://api.pushover.net/1/messages.json >/dev/null 2>&1 \
			&& touch "$ESCALATED"
	fi
fi

exit 0
