[Unit]
Description=Ping the off-boat dead man's switch every 5 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
# The boat's uplink is intermittent by nature. Spread the pings so a whole
# marina's worth of devices doesn't hit the same second after a power cut.
RandomizedDelaySec=30s
# Don't fire a catch-up ping for time spent powered off -- the missing pings
# are the signal, and replaying them would paper over the outage.
Persistent=false

[Install]
WantedBy=timers.target
