# TLS front door for the web UIs. Certificates: Let's Encrypt via
# Cloudflare DNS-01 -- nothing needs to be reachable *from* the internet,
# but issuance and renewal need outbound internet. Offline cert behavior:
# RUNBOOK.md, "SSO access grants" (Offshore).

{
	email {$ACME_EMAIL}
}

signalk.{$DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy signalk-server:3000
}

grafana.{$DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy grafana:3000
}

auth.{$DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy dex:5556
}
