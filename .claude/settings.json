{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tailscale-join.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(send_later|create_trigger)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/no-persistent-polling.sh"
          }
        ]
      }
    ]
  },
  "deniedMcpServers": [
    {
      "serverName": "Gmail"
    },
    {
      "serverName": "Google_Drive"
    },
    {
      "serverName": "Intuit_QuickBooks"
    },
    {
      "serverName": "Intuit_TurboTax"
    }
  ]
}
