{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tailscale-join.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-secret-printing-compose-config.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/warn-shared-checkout.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log-host-commands.sh"
          }
        ]
      }
    ]
  },
  "crossSessionInbound": "hold",
  "deniedMcpServers": [
    {
      "serverName": "Gmail"
    },
    {
      "serverName": "Google_Drive"
    },
    {
      "serverName": "Intuit_QuickBooks"
    },
    {
      "serverName": "Intuit_TurboTax"
    },
    {
      "serverName": "Google_Calendar"
    },
    {
      "serverName": "CourtListener"
    },
    {
      "serverName": "Courtroom5"
    },
    {
      "serverName": "Legal_Data_Hunter"
    },
    {
      "serverName": "LegalZoom"
    }
  ]
}
