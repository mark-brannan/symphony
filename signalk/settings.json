    "apiOnly": false
  },
  "mdns": true,
  "ssl": false,
  "wsCompression": false,
  "wsPingInterval": 30000,
  "accessLogging": true,
  "enablePluginLogging": true,
  "trustProxy": true,
  "port": 3000,
  "sslport": 3443,
  "pruneContextsMinutes": 60,
  "keepMostRecentLogsOnly": true,
  "logCountToKeep": 24
