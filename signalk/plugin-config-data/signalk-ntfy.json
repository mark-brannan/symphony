{
  "configuration": {
    "enabled": true,
    "servers": [
      {
        "id": "local",
        "name": "Self-hosted ntfy",
        "url": "http://localhost:8090",
        "isDefault": true
      }
    ],
    "topic": "symphony-alarms",
    "filterDuplicates": false,
    "minIntervalMinutes": 5,
    "levels": [
      "alert",
      "warn",
      "alarm",
      "emergency"
    ],
    "listenForCommands": false
  },
  "enabled": true
}