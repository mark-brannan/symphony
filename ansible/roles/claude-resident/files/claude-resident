#!/bin/sh
# Resident Claude Code session, reachable by Remote Control instead of a
# held-open SSH connection. Attach locally with: tmux attach -t claude
set -eu

SESSION=claude
DIR=/home/pi/symphony

if tmux has-session -t "$SESSION" 2>/dev/null; then
	exit 0
fi

# Resume the last conversation rather than starting cold, so a reboot doesn't
# throw away whatever was in flight. Transcripts survive the process; the
# session's Remote Control URL does not, so expect a new link each boot.
# --continue fails outright when there is no prior conversation for $DIR, so
# only pass it once one exists.
transcripts="$HOME/.claude/projects/$(printf '%s' "$DIR" | tr / -)"
resume=""
if [ -n "$(find "$transcripts" -maxdepth 1 -name '*.jsonl' -print -quit 2>/dev/null)" ]; then
	resume="--continue"
fi

# The trailing shell keeps the pane alive if claude exits, so the session is
# still there to attach to and restart from.
exec tmux new-session -d -s "$SESSION" -c "$DIR" \
	"claude $resume --remote-control symphony-pi; echo; echo \"[claude exited - restart with: claude --continue --remote-control symphony-pi]\"; exec bash -l"
