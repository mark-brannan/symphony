# Template for hostvars.local.yaml -- this machine's values for the
# {{ placeholders }} in files listed in .hostvars.yaml. Copy to
# hostvars.local.yaml (gitignored), set the values for THIS machine, then
# run `bash scripts/setup-git-filters.sh` (fresh clone) or
# `python3 scripts/hostvars_filter.py refresh` (value changed).
#
# Values must be non-empty strings, distinct from each other.

# URL SignalK uses to reach the ntfy server (signalk-ntfy plugin).
#   dev docker stack:  http://ntfy:80        (service name on symphony-net)
#   boat Pi:           http://localhost:8090 (native SignalK -> ntfy container's published port)
ntfy_url: http://ntfy:80
