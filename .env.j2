# .env -- rendered by scripts/render.py from secrets/symphony.sops.yaml.
# DO NOT EDIT BY HAND; edit the source (`sops secrets/symphony.sops.yaml`)
# and re-render instead, or your changes will be overwritten.

TZ=America/Los_Angeles

DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME={{ influxdb_init_username }}
DOCKER_INFLUXDB_INIT_PASSWORD={{ influxdb_captain_password }}
DOCKER_INFLUXDB_INIT_ORG={{ influxdb_init_org }}
DOCKER_INFLUXDB_INIT_BUCKET={{ influxdb_init_bucket }}
DOCKER_INFLUXDB_INIT_RETENTION=30d

INFLUX_TOKEN={{ influx_token }}

# Telegraf's write path. Deliberately a separate variable from INFLUX_TOKEN:
# this is captain's all-access token, used as a stopgap because the three
# other Influx tokens in sops no longer authenticate. Replace with a token
# scoped to the host-metrics bucket once that's reconciled -- see
# maintenance/priorities.md.
TELEGRAF_INFLUX_TOKEN={{ influxdb_captain_token }}
TELEGRAF_INFLUX_ORG=symphony
TELEGRAF_INFLUX_BUCKET=symphony

GF_SECURITY_ADMIN_USER={{ grafana_superadmin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_superadmin_password }}

DOMAIN={{ boat_domain }}
ACME_EMAIL={{ owner_email }}
CLOUDFLARE_API_TOKEN={{ cloudflare_api_token }}

SIGNALK_OIDC_ENABLED=true
SIGNALK_OIDC_ISSUER=https://auth.{{ boat_domain }}/dex
SIGNALK_OIDC_CLIENT_ID=symphony
SIGNALK_OIDC_CLIENT_SECRET={{ dex_symphony_client_secret }}
SIGNALK_OIDC_REDIRECT_URI=https://signalk.{{ boat_domain }}/signalk/v1/auth/oidc/callback
SIGNALK_OIDC_SCOPE=openid email profile
SIGNALK_OIDC_DEFAULT_PERMISSION=readonly
# SignalK's permission mapper only reads groups, and neither provider
# sends any. GROUPS_ATTRIBUTE repoints it at a different claim, and the
# server wraps a bare string into a one-element list -- so the email
# claim becomes the "group" and ADMIN_GROUPS below is an email allowlist.
# Works for GitHub and Google alike, because it needs nothing of the
# connector: Dex already carries email for both.
SIGNALK_OIDC_GROUPS_ATTRIBUTE=email
# Comma-separated, matched literally and case-sensitively. One address
# per admin. Everyone else falls through to DEFAULT_PERMISSION.
SIGNALK_OIDC_ADMIN_GROUPS={{ owner_email }}
SIGNALK_OIDC_PROVIDER_NAME=GitHub / Google
SIGNALK_OIDC_AUTO_LOGIN=false

GF_SERVER_ROOT_URL=https://grafana.{{ boat_domain }}
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=GitHub / Google
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=symphony
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ dex_symphony_client_secret }}
GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.{{ boat_domain }}/dex/auth
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.{{ boat_domain }}/dex/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.{{ boat_domain }}/dex/userinfo
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_USE_REFRESH_TOKEN=false
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=email=='{{ owner_email }}' && 'Admin'
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_LOGIN_MAXIMUM_INACTIVE_LIFETIME_DURATION=30d
GF_AUTH_LOGIN_MAXIMUM_LIFETIME_DURATION=90d
