.npmrc
node_modules
.DS_Store
tmp/
*.swp
signalk/appstore-cache/

# plugin cache/generated/runtime data -- not configuration, some of it
# huge (noaa-sonar-chart-provider/ alone has run to 1.4GB before)
signalk/plugin-config-data/kip/
signalk/plugin-config-data/noaa-sonar-chart-provider/
signalk/plugin-config-data/signalk-crows-nest/
signalk/plugin-config-data/signalk-autostate/
signalk/plugin-config-data/signalk-checklist/
signalk/plugin-config-data/signalk-container/
signalk/plugin-config-data/signalk-dsc/
signalk/plugin-config-data/signalk-grafana/
signalk/plugin-config-data/signalk-marinetraffic-public/
signalk/plugin-config-data/signalk-notification-player/ 
signalk/plugin-config-data/signalk-noaa-space-weather/ 
signalk/plugin-config-data/signalk-postgsail/
signalk/plugin-config-data/signalk-questdb/
signalk/plugin-config-data/signalk-restricted-areas/
signalk/plugin-config-data/tides/
# saillogger_buffer.ndjson is a disposable send queue (has run to 9MB+);
# saillogger_config.json is real key-mapping config and stays tracked.
signalk/plugin-config-data/signalk-saillogger/saillogger_buffer.ndjson
# canboatjs address-claim cache and SignalK's source metadata: written as
# traffic is seen, never hand-edited, and not on the boat's sync either.
signalk/canboatjs-data.json
signalk/sources-cache.json

# Node-RED's own generated state: installed-node cache and per-instance id,
# not configuration -- regenerates from signalk/red/package.json + flows.
signalk/red/.config.nodes.json
signalk/red/.config.runtime.json


# secrets / rendered config -- see RUNBOOK.md
.env
age.key
rendered/

# pulled-from-the-boat snapshots -- large, and carry live tokens/password
# hashes (grafana.db, signalk security.json, influx cli configs)
raw_backups/
__pycache__/
dex/config.yaml

# Local mode override for the pre-commit guards (scripts/secretguard.sh).
# Per-machine, never shared: committed as "contributor" it would silently
# degrade every maintainer that pulls it.
.secretguard-mode

# ssh-command buffer for the as-built file (.claude/hooks/log-host-commands.sh)
# -- a local scratch log, never committed.
intermediate_files/claude_slop/host-commands.log
