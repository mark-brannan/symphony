# cp to .env and fill in. Gitignored -- see the note in compose.yml about why
# this one file is deliberately not sops-encrypted.

# Tailnet auth key. Reusable, NOT ephemeral: an ephemeral node vanishes when
# the container stops and takes the vaultwarden.* DNS name with it.
TS_AUTHKEY=tskey-auth-...

# Unlocks /admin. Generate with:
#   docker run --rm ghcr.io/dani-garcia/vaultwarden:latest /vaultwarden hash
ADMIN_TOKEN=

# Where the sqlite database and RSA key live. Outside the repo.
VAULTWARDEN_DATA=/home/solace/vaultwarden/data
